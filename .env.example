# Copy this file to .env and fill in real values. Never commit the real .env file (see .gitignore).
# Loaded locally via spring-dotenv; in Azure App Service, set these as real App Settings instead.

# --- Azure OpenAI ---
# Resource endpoint, e.g. https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# These are Azure OpenAI *deployment* names you create in your resource, not raw model names -
# e.g. you might deploy the gpt-4o-mini base model under a deployment named "gpt-4o-mini-deskhand".
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Must match the embedding deployment's actual output size, and the Azure AI Search index's
# contentVector field dimension - text-embedding-3-small defaults to 1536. Changing this after the
# index is created means recreating the index.
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Azure AI Search ---
# Resource endpoint, e.g. https://<your-search-service-name>.search.windows.net
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=company-docs

# --- Spring ---
# "local" enables verbose logging (see application-local.yml). Leave unset/blank in production.
SPRING_PROFILES_ACTIVE=local
